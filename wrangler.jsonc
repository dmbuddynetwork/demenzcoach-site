// Cloudflare-Hosting von dementiacoachapp.com (Workers mit statischen Dateien, seit 8. Nov 2026).
// html_handling "none": Adressen wie /datenschutz.html bleiben wie auf GitHub Pages (kein Umleiten auf /datenschutz).
// Fehlende Ordner-Startseiten und 404 übernimmt cloudflare-worker.js. Nicht ausgeliefert: siehe .assetsignore.
{
  "name": "dementiacoachapp",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    // Alte Startseiten-Dateien liegen als HTML-Weiterleitungs-Stubs weiter im Repo (Fallback für
    // GitHub Pages). Damit Cloudflare sie nicht direkt ausliefert, läuft für genau diese Adressen
    // der Worker zuerst und antwortet mit 301 auf /de/ bzw. /xx/ (Liste wie HOME_LANGUAGES im Worker).
    "run_worker_first": [
      "/teller", "/teller/", "/teller/index.html",
      "/de/", "/de/index.html",
      "/en/", "/en/index.html", "/en/dementia-translator/", "/en/dementia-translator/index.html",
      "/demenz-uebersetzer", "/demenz-uebersetzer/*",
      "/ratgeber", "/ratgeber/*",
      "/de/demenz-uebersetzer/", "/de/demenz-uebersetzer/index.html",
      "/de/ratgeber/", "/de/ratgeber/index.html",
      "/",
      "/index.html",
      "/index-en.html", "/index-pl.html", "/index-ro.html", "/index-bg.html",
      "/index-hr.html", "/index-sk.html", "/index-hu.html", "/index-cs.html",
      "/index-uk.html", "/index-bs.html", "/index-sr.html", "/index-lt.html",
      "/index-sl.html", "/index-lv.html", "/index-et.html", "/index-ru.html",
      "/index-tr.html", "/index-ar.html", "/index-fr.html", "/index-it.html",
      "/index-es.html", "/index-pt.html", "/index-nl.html", "/index-el.html",
      "/index-sq.html", "/index-fa.html", "/index-th.html", "/index-da.html",
      "/index-fi.html", "/index-ga.html", "/index-mt.html", "/index-sv.html",
      // Exact built generator canonicals: queries must run through the registered router.
      "/de/angehoerige/pflege-mit-geschwistern-aufteilen.html",
      "/de/demenz-uebersetzer/da-ist-jemand-im-zimmer.html",
      "/de/demenz-uebersetzer/das-essen-ist-vergiftet.html",
      "/de/demenz-uebersetzer/die-nachbarn-reden-ueber-mich.html",
      "/de/demenz-uebersetzer/du-hast-einen-anderen.html",
      "/de/demenz-uebersetzer/du-hast-mein-geld-gestohlen.html",
      "/de/demenz-uebersetzer/du-luegst-mich-an.html",
      "/de/demenz-uebersetzer/es-wird-dunkel-ich-muss-los.html",
      "/de/demenz-uebersetzer/hilfe-hilfe-rufen.html",
      "/de/demenz-uebersetzer/ich-bin-doch-kein-kind.html",
      "/de/demenz-uebersetzer/ich-bin-doch-nicht-dement.html",
      "/de/demenz-uebersetzer/ich-bin-hier-eingesperrt.html",
      "/de/demenz-uebersetzer/ich-bleibe-heute-im-bett.html",
      "/de/demenz-uebersetzer/ich-finde-die-toilette-nicht.html",
      "/de/demenz-uebersetzer/ich-gehe-nicht-in-die-tagespflege.html",
      "/de/demenz-uebersetzer/ich-habe-noch-nichts-gegessen.html",
      "/de/demenz-uebersetzer/ich-habe-schon-gegessen.html",
      "/de/demenz-uebersetzer/ich-kann-gar-nichts-mehr.html",
      "/de/demenz-uebersetzer/ich-muss-aufstehen-nachts.html",
      "/de/demenz-uebersetzer/ich-muss-jemanden-anrufen.html",
      "/de/demenz-uebersetzer/ich-muss-nicht-aufs-klo.html",
      "/de/demenz-uebersetzer/ich-muss-noch-einkaufen.html",
      "/de/demenz-uebersetzer/ich-muss-zur-arbeit.html",
      "/de/demenz-uebersetzer/ich-nehme-keine-tabletten.html",
      "/de/demenz-uebersetzer/ich-will-auto-fahren.html",
      "/de/demenz-uebersetzer/ich-will-das-ausziehen.html",
      "/de/demenz-uebersetzer/ich-will-nicht-duschen.html",
      "/de/demenz-uebersetzer/ich-will-nicht-ins-bett.html",
      "/de/demenz-uebersetzer/ich-will-nicht-ins-heim.html",
      "/de/demenz-uebersetzer/ich-ziehe-mich-nicht-um.html",
      "/de/demenz-uebersetzer/lass-mich-in-ruhe.html",
      "/de/demenz-uebersetzer/lass-mich-nicht-allein.html",
      "/de/demenz-uebersetzer/mir-ist-langweilig.html",
      "/de/demenz-uebersetzer/mir-ist-so-kalt.html",
      "/de/demenz-uebersetzer/wann-gehen-wir.html",
      "/de/demenz-uebersetzer/wann-kommt-mein-sohn.html",
      "/de/demenz-uebersetzer/wer-sind-sie.html",
      "/de/demenz-uebersetzer/wo-bin-ich.html",
      "/de/demenz-uebersetzer/wo-ist-mein-hund.html",
      "/de/demenz-uebersetzer/wo-ist-mein-mann.html",
      "/de/demenz-uebersetzer/wo-ist-meine-mutter.html",
      "/de/demenz-uebersetzer/wo-sind-meine-kinder.html",
      "/de/ratgeber/demenz-nach-hause-was-sagen.html",
      "/de/ratgeber/pflegende-angehoerige-ueberfordert.html",
      "/en/caregivers/share-dementia-care-with-siblings.html",
      "/en/dementia-translator/dont-leave-me.html",
      "/en/dementia-translator/help-help.html",
      "/en/dementia-translator/i-can-still-drive.html",
      "/en/dementia-translator/i-cant-do-anything-anymore.html",
      "/en/dementia-translator/i-cant-find-the-toilet.html",
      "/en/dementia-translator/i-dont-need-the-bathroom.html",
      "/en/dementia-translator/i-dont-want-a-shower.html",
      "/en/dementia-translator/i-dont-want-to-go-to-bed.html",
      "/en/dementia-translator/i-have-to-call-someone.html",
      "/en/dementia-translator/i-have-to-get-up-now.html",
      "/en/dementia-translator/i-have-to-go-shopping.html",
      "/en/dementia-translator/i-have-to-go-to-work.html",
      "/en/dementia-translator/i-havent-eaten-all-day.html",
      "/en/dementia-translator/i-want-to-go-home.html",
      "/en/dementia-translator/i-want-to-take-this-off.html",
      "/en/dementia-translator/im-locked-in-here.html",
      "/en/dementia-translator/im-not-a-child.html",
      "/en/dementia-translator/im-not-changing-my-clothes.html",
      "/en/dementia-translator/im-not-going-into-a-home.html",
      "/en/dementia-translator/im-not-going-to-day-care.html",
      "/en/dementia-translator/im-not-taking-those-pills.html",
      "/en/dementia-translator/im-so-bored.html",
      "/en/dementia-translator/im-so-cold.html",
      "/en/dementia-translator/im-staying-in-bed-today.html",
      "/en/dementia-translator/its-getting-dark-i-have-to-go.html",
      "/en/dementia-translator/ive-already-eaten.html",
      "/en/dementia-translator/leave-me-alone.html",
      "/en/dementia-translator/someone-stole-my-purse.html",
      "/en/dementia-translator/the-food-is-poisoned.html",
      "/en/dementia-translator/the-neighbors-are-talking-about-me.html",
      "/en/dementia-translator/theres-nothing-wrong-with-me.html",
      "/en/dementia-translator/theres-someone-in-the-room.html",
      "/en/dementia-translator/when-are-we-leaving.html",
      "/en/dementia-translator/when-is-my-son-coming.html",
      "/en/dementia-translator/where-am-i.html",
      "/en/dementia-translator/where-are-my-children.html",
      "/en/dementia-translator/where-is-my-dog.html",
      "/en/dementia-translator/where-is-my-husband.html",
      "/en/dementia-translator/where-is-my-mother.html",
      "/en/dementia-translator/who-are-you.html",
      "/en/dementia-translator/youre-lying-to-me.html",
      "/en/dementia-translator/youre-seeing-someone-else.html",
      "/guides/dementia-caregiver-overwhelmed.html"
    ]
  },
  "observability": { "enabled": false },
  // Branch-Builds in Cloudflare laufen mit "npx wrangler preview" und brauchen diesen Block (sonst schlägt jeder PR-Build fehl).
  "previews": {}
}
